---
import '../styles/global.css';
import { profile } from '../lib/profile';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Page not found | {profile.name}</title>
  <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">
  <style is:inline>
    .nf { max-width: 36rem; margin: 18vh auto 0; padding: 0 1.25rem; text-align: center; }
    .nf h1 { margin-bottom: .5rem; }
    .nf p { color: var(--muted); }
    .nf .links { justify-content: center; margin-top: 1.5rem; }
  </style>
</head>
<body>
  <main class="nf">
    <h1>404</h1>
    <p>This page doesn't exist. <span lang="zh-Hans">页面不存在。</span></p>
    <nav class="links">
      <a class="pill" href="/">Home</a>
      <a class="pill" href="/zh/" lang="zh-Hans">中文主页</a>
    </nav>
  </main>
</body>
</html>
